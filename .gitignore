apps/web/tests/e2e-internal/test-results/
apps/web/playwright-report-internal/

# pnpm depcruise and pnpm check:supabase-scope plant these files for one run and
# always delete them. Matched by name, not by path: a killed run would otherwise
# leave a rule-violating source file inside apps/*/src, untracked and easy to
# commit by accident, and the next ticket's planted path is covered already.
**/__dependency-violation__.ts
**/__supabase-scope-violation__.ts

# Claude Code agent worktrees (local only)
.claude/worktrees/
# Playwright MCP browser session output (screenshots, traces; local only)
.playwright-mcp/
graphify-out/.graphify_python
