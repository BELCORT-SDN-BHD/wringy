{
  "version": "1.0-prototype",
  "source": "../design-v3/tokens.json",
  "status": "用户授权本地设计原型；非生产设计系统",
  "themes": {
    "light": {
      "status": "fully-defined"
    },
    "dark": {
      "status": "future-not-implemented",
      "requirement": "需逐对验证语义颜色与组件对比；禁止简单反转"
    }
  },
  "primitive": {
    "color": {
      "canvas": "#FFFFFF",
      "surface": "#F6F6F3",
      "ink": "#171A14",
      "citron": "#E4F222",
      "forest": "#173D2A",
      "line": "#E1E3DC",
      "secondary": "#5C6258",
      "error": "#A52A2A",
      "success": "#24623E",
      "focus": "#3658A4",
      "warning": "#795000",
      "warningBg": "#FFF4D6",
      "successBg": "#EAF3ED",
      "errorBg": "#FCEEEE",
      "infoBg": "#EDF1FA"
    },
    "space": {
      "xs": 4,
      "sm": 8,
      "md": 16,
      "lg": 24,
      "xl": 32,
      "section": 64
    },
    "radius": {
      "control": 6,
      "panel": 12
    },
    "font": {
      "sans": "Arial, Helvetica, \"Noto Sans SC\", \"PingFang SC\", sans-serif"
    },
    "motion": {
      "fast": "120ms",
      "standard": "180ms",
      "ease": "cubic-bezier(0.23, 1, 0.32, 1)"
    },
    "layout": {
      "sidebar": "232px",
      "content": "1200px",
      "touch": "44px",
      "reading": "720px"
    },
    "border": {
      "width": "1px",
      "focus-width": "3px",
      "focus-offset": "3px"
    },
    "elevation": {
      "subtle": "0 1px 3px #171A140D",
      "panel": "0 14px 36px #171A1410",
      "popover": "0 12px 40px #171A1426",
      "dialog": "0 24px 80px #171A1433",
      "toast": "0 10px 40px #171A1420",
      "overlay": "#171A1466"
    },
    "z": {
      "sidebar": "30",
      "mobile": "40",
      "popover": "50",
      "toast": "100",
      "skip": "200"
    },
    "icon": {
      "small": "20px",
      "standard": "24px",
      "stroke": "1.75"
    },
    "breakpoint": {
      "mobile": "700px",
      "tablet": "900px",
      "desktop": "1150px",
      "wide": "1600px"
    }
  },
  "semantic": {
    "canvas": "{primitive.color.canvas}",
    "surface": "{primitive.color.surface}",
    "text": "{primitive.color.ink}",
    "muted": "{primitive.color.secondary}",
    "border": "{primitive.color.line}",
    "control-border": "{primitive.color.secondary}",
    "accent": "{primitive.color.citron}",
    "forest": "{primitive.color.forest}",
    "danger": "{primitive.color.error}",
    "danger-bg": "{primitive.color.errorBg}",
    "positive": "{primitive.color.success}",
    "positive-bg": "{primitive.color.successBg}",
    "warning": "{primitive.color.warning}",
    "warning-bg": "{primitive.color.warningBg}",
    "focus": "{primitive.color.focus}",
    "info-bg": "{primitive.color.infoBg}"
  },
  "component": {
    "button-background": "{semantic.accent}",
    "button-text": "{semantic.text}",
    "button-height": "{primitive.layout.touch}",
    "input-border": "{semantic.control-border}",
    "tab-selected": "{semantic.text}",
    "row-selected": "{semantic.surface}",
    "dialog-background": "{semantic.canvas}"
  },
  "typography": {
    "display": {
      "size": 56,
      "lineHeight": 1.2,
      "weight": 600
    },
    "brandHeading": {
      "size": 40,
      "lineHeight": 1.3,
      "weight": 600
    },
    "objectHeading": {
      "size": 32,
      "lineHeight": 1.4,
      "weight": 600
    },
    "sectionHeading": {
      "size": 24,
      "lineHeight": 1.4,
      "weight": 600
    },
    "body": {
      "size": 18,
      "lineHeight": 1.65,
      "weight": 400
    },
    "app": {
      "size": 15,
      "lineHeight": 1.5,
      "weight": 400
    },
    "caption": {
      "size": 13,
      "lineHeight": 1.5,
      "weight": 400
    },
    "mobileHeading": {
      "size": 30,
      "lineHeight": 1.3,
      "weight": 600
    },
    "deckLabel": {
      "size": 32,
      "lineHeight": 1.35,
      "weight": 600
    }
  },
  "rules": {
    "money": "未知金额显示 — 并同时标注尚未确认；已知零显示 MYR 0.00；币种始终明确；示例不是奖励规则",
    "payment": "审核、资格与处理状态不证明银行已付款",
    "motion": "键盘触发立即响应；reduced-motion禁用位移",
    "touch": "交互目标至少44×44px"
  }
}
