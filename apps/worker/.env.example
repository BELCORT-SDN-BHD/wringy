# apps/worker environment: NAMES ONLY. Never commit a value.
#
# Copy to apps/worker/.env (gitignored) for `pnpm --filter worker dev` and
# `start`; both load it with --env-file-if-exists. Staging and production values
# live only in the platform's secret store (kickoff-package.md §8.5). The worker
# reads exactly these variables through @wringy/config/worker and fails fast,
# naming a missing or invalid variable without echoing its value.

# Which environment this process belongs to: local | ci | staging | production.
# The worker refuses to start unless ops.environment in the database says the same.
WRINGY_ENV=

# PostgreSQL URL for the WORKER runtime login (wringy_worker_login), never the
# API's or the migrator's. Locally, `pnpm db:start` prints it.
DATABASE_URL=

# Stable id of this worker instance: the primary key of its ops.worker_heartbeat row.
WORKER_ID=

# Image reference (git SHA tag or digest) this worker runs, shown on the health card.
IMAGE_REF=

# pino level: fatal | error | warn | info | debug | trace | silent (default info).
LOG_LEVEL=
