# apps/api environment: NAMES ONLY. Never commit a value.
#
# Copy to an untracked apps/api/.env for local use; `pnpm dev` and `pnpm start`
# load it with --env-file-if-exists. The local values for the embedded cluster
# (pnpm db:start) come from packages/db (see its README); staging and production
# values live only in the platform's secret store. @wringy/config/api validates
# these at startup and names a missing or invalid variable without its value.

# Which environment this process belongs to: local | ci | staging | production.
# The API refuses to start unless it equals the database's ops.environment marker.
WRINGY_ENV=

# PostgreSQL URL for the API runtime login (wringy_api_login), never the
# migrator's or the worker's login.
DATABASE_URL=

# Origin of this environment's Supabase project, e.g. https://<ref>.supabase.co.
# An origin only: no trailing slash, no /auth/v1 path, no query. Every token is
# verified against this project's JWKS and issuer.
SUPABASE_URL=

# Supabase PUBLISHABLE key (sb_publishable_...), used for the session-liveness
# call to the Auth server. Never a secret key (sb_secret_...) or a service role
# key: the API holds neither.
SUPABASE_PUBLISHABLE_KEY=

# How the API answers "is this session still live?" (no default, both are valid):
#   database    - call platform.session_is_live(session_id, user_id). Only where
#                 the app database IS the Supabase project's database.
#   auth_server - call GET <SUPABASE_URL>/auth/v1/user with the caller's token.
SESSION_LIVENESS=

# Listen port (default 3200) and host (default 127.0.0.1).
PORT=
HOST=

# pino level: fatal | error | warn | info | debug | trace | silent (default info).
LOG_LEVEL=
