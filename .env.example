# Wringy environment variables: NAMES ONLY. Never commit a value.
#
# Copy to an untracked `.env` for local use (`.gitignore` ignores `.env` and
# `.env.*` except this file). The local values for the embedded PostgreSQL
# cluster are printed by `pnpm db:start`. Staging and production values live
# only in the platform's secret store (kickoff-package.md §7.4, §8.5).
#
# Which file each process reads locally:
# - the repository-root `.env` (this file's copy): the packages/db scripts
#   (db:bootstrap, db:migrate, db:env, db:seed:fixtures);
# - `apps/api/.env`, from apps/api/.env.example: the API (`pnpm --filter api dev`);
# - `apps/worker/.env`, from apps/worker/.env.example: the worker.
# The api and worker each use their own DATABASE_URL login, which is why they
# keep separate files; both are gitignored by the `.env` rule in `.gitignore`.
#
# Each process reads only its own variables through @wringy/config, which
# fails fast and names a missing or invalid variable without echoing its value.

# --- Shared by every process --------------------------------------------------
# Which environment this process belongs to: local | ci | staging | production.
WRINGY_ENV=

# --- web (apps/web, Next.js server) -------------------------------------------
# Server-to-server base URL of the Fastify API, e.g. http://127.0.0.1:3200.
# The web server gets no database URL and no NEXT_PUBLIC_* variable.
API_INTERNAL_URL=

# Which implementation this web server renders: demo | internal (default demo).
# demo is the M1 demonstration build and needs nothing below it. internal is the
# server-backed internal build and needs the three variables that follow.
# The server does NOT refuse to start without them, on purpose: /internal renders
# its "not configured" state naming each missing variable, and every sign-in
# endpoint answers 503 not_configured. So a deploy that is missing one looks
# healthy — open /internal after deploying and read that page.
WRINGY_APP_MODE=

# Origin of this environment's Supabase project, e.g. https://<ref>.supabase.co.
# An origin only: no trailing slash, no /auth/v1 path, no query. https:// unless
# the host is loopback: this is the key set every access token is verified
# against, so plaintext to a hosted host would let anyone on the path mint tokens.
SUPABASE_URL=

# Supabase PUBLISHABLE key (sb_publishable_...). It is publishable by design and
# is still read on the server only. No secret key (sb_secret_...) and no service
# role key ever goes to the web server or the api, in any variable — the schema
# refuses one here rather than leaving that to this comment.
SUPABASE_PUBLISHABLE_KEY=

# Public origin this web server is reached at, e.g. http://127.0.0.1:3100. Every
# redirect and the Origin allow-list are built from it, never from the Host or
# X-Forwarded-Host header. An origin only, as above.
APP_ORIGIN=

# --- api (apps/api, Fastify) ----------------------------------------------------
# Names and comments: apps/api/.env.example (WRINGY_ENV, DATABASE_URL as
# wringy_api_login, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SESSION_LIVENESS,
# PORT default 3200, HOST default 127.0.0.1, LOG_LEVEL).

# --- worker (apps/worker, pg-boss) -----------------------------------------------
# Names and comments: apps/worker/.env.example (WRINGY_ENV, DATABASE_URL as
# wringy_worker_login, WORKER_ID, IMAGE_REF, LOG_LEVEL).

# --- migrate (pnpm db:migrate, pnpm db:env, pnpm db:seed:fixtures) --------------
# PostgreSQL URL for the migration owner (wringy_migrator). DDL, the environment
# marker (ops.environment) and the fixture seed are written only through it.
DATABASE_URL_MIGRATOR=

# --- bootstrap (pnpm db:bootstrap, pnpm db:platform-bootstrap; once each) -------
# Admin connection that may create roles and databases. Optional when
# WRINGY_ENV=local (the embedded cluster's superuser is used); required otherwise.
PG_BOOTSTRAP_ADMIN_URL=
# Name of the application database (default wringy).
PG_BOOTSTRAP_DATABASE=
# Passwords for the three login roles. Optional only for the embedded local
# cluster: WRINGY_ENV=local AND PG_BOOTSTRAP_ADMIN_URL unset or on this machine at
# the `pnpm db:start` port (fixed development passwords are used then). Required
# everywhere else, WRINGY_ENV=local with any other admin URL included, and a
# development password is refused there.
PG_BOOTSTRAP_MIGRATOR_PASSWORD=
PG_BOOTSTRAP_API_PASSWORD=
PG_BOOTSTRAP_WORKER_PASSWORD=

# --- tests (pnpm test:int, pnpm e2e:internal) -----------------------------------
# Admin URL of an existing, THROWAWAY PostgreSQL 17 cluster (CI's postgres:17
# service, or `pnpm db:start`'s). The harness resets the cluster-wide wringy_*
# login passwords to the committed development values and creates and drops
# databases there, so it refuses a host that is not this machine (unless
# WRINGY_TEST_CLUSTER_IS_THROWAWAY=1) and a cluster with a database marked as
# anything but local or ci. Never point it at a shared, staging or production
# cluster. Unset: the harness starts a throwaway embedded PostgreSQL instead.
TEST_DATABASE_URL=
