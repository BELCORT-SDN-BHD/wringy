{
  "name": "wringy",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:int": "pnpm -r run test:int",
    "e2e": "pnpm --filter web e2e",
    "db:start": "pnpm --filter @wringy/db run db:start",
    "db:stop": "pnpm --filter @wringy/db run db:stop",
    "db:bootstrap": "pnpm --filter @wringy/db run db:bootstrap",
    "db:migrate": "pnpm --filter @wringy/db run migrate",
    "depcruise": "node scripts/check-dependency-direction.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "18.4.0",
    "typescript": "^5"
  }
}
